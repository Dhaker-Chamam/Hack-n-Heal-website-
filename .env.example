# --- Database (Supabase Postgres, role hnh_app via the transaction pooler, port 6543)
DATABASE_URL=postgres://hnh_app.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Supabase Storage (CV uploads). Leave empty to hide CV upload.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Secrets: long random strings (openssl rand -hex 32)
APP_SECRET=
HASH_SALT=

# --- Public URL
APP_URL=http://localhost:3000

# --- Email (club mailbox SMTP). Leave SMTP_HOST empty in dev: emails are stored in the outbox and printed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hack'n'Heal 2026 <adresse@exemple.tn>"

# --- Staff bootstrap: comma-separated emails that are admins even before the staff table is filled
ADMIN_EMAILS=

# --- Privacy notice
DATA_CONTROLLER_NAME=Symbio INSAT
DATA_CONTROLLER_CONTACT=

# --- Optional Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=
